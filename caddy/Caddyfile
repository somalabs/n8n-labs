# Proxy reverso com HTTPS automático. N8N_HOST e ACME_EMAIL vêm do .env via
# environment do serviço caddy no docker-compose.yml.
#
# Sem domínio próprio, N8N_HOST pode ser <ip>.sslip.io — resolve para o IP e
# o Let's Encrypt emite normalmente (o IP precisa ser estático: gcp-setup.sh).
{
	email {$ACME_EMAIL}
}

{$N8N_HOST} {
	encode zstd gzip

	# n8n usa websocket/SSE para o editor; reverse_proxy repassa transparente.
	reverse_proxy n8n:5678 {
		flush_interval -1
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output stdout
		format console
	}
}
