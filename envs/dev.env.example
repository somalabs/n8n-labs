# Configuração de desenvolvimento — arquivo LOCAL, fora do git (ver envs/dev.env.example).
# Desenvolvimento (n8n-dev, us-central1-f, e2-medium).
# Secrets vêm do Secret Manager na hora do deploy — não coloque aqui.

# Dev pode andar na frente de prod para validar a versão antes de promover.
N8N_VERSION=2.38.7

# DNS interno (registro A → IP interno da VM, 10.0.96.73). Só resolve/alcança
# quem está na VPN. HTTP puro na porta N8N_PUBLISH_PORT; sem proxy na frente.
N8N_HOST=n8n-dev.somalabs.com.br
N8N_PUBLISH_PORT=80

# Banco: Cloud SQL `n8n` (Postgres 18, IP privado na soma-network). A mesma
# instância atende dev e prod, cada um no seu database, com um usuário que JÁ
# EXISTE na instância (nada é criado): a senha dele vai no secret
# n8n-dev-postgres-password (./scripts/secrets.sh dev set POSTGRES_PASSWORD).
# `make deploy` cria o database se faltar e confere que o usuário existe.
POSTGRES_HOST=10.232.168.6
POSTGRES_PORT=5432
POSTGRES_DB=n8n_dev
POSTGRES_USER=postgres
# Versão do client (pg_dump/psql) usado por backup/restore/psql na VM.
# Acompanhe a major da instância.
POSTGRES_VERSION=18

# Regular mode: um único processo n8n (e2-medium = 2 vCPU / 4 GB).
COMPOSE_PROFILES=
EXECUTIONS_MODE=regular

# Retenção curta: dev acumula lixo de teste.
EXECUTIONS_DATA_MAX_AGE=72
EXECUTIONS_DATA_PRUNE_MAX_COUNT=10000
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all

TZ=America/Sao_Paulo
N8N_LOG_LEVEL=debug
N8N_VERSION_NOTIFICATIONS_ENABLED=true
N8N_METRICS=false

BACKUP_RETENTION_DAYS=7
BACKUP_BUCKET=
