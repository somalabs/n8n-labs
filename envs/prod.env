# Configuração NÃO sensível de produção (n8n-prod, us-central1-a, e2-standard-4).
# Secrets (POSTGRES_PASSWORD, N8N_ENCRYPTION_KEY, N8N_JWT_SECRET) vêm do Secret
# Manager e são anexados na hora do deploy — não coloque aqui.

# Versão do n8n. Para atualizar: mude aqui e rode `make deploy ENV=prod`.
N8N_VERSION=2.38.7

# DNS interno (registro A → IP interno da VM, 10.0.96.72). Só resolve/alcança
# quem está na VPN. HTTP puro na porta N8N_PUBLISH_PORT; sem proxy na frente.
N8N_HOST=n8n-prod.somalabs.com.br
N8N_PUBLISH_PORT=80

# Banco: Cloud SQL `n8n` (Postgres 18, IP privado na soma-network). A mesma
# instância atende dev e prod; cada ambiente tem seu database + usuário.
# `make deploy` cria database/usuário se faltarem (scripts/cloudsql.sh).
# A senha é o secret n8n-prod-postgres-password.
POSTGRES_HOST=10.232.168.6
POSTGRES_PORT=5432
POSTGRES_DB=n8n_prod
POSTGRES_USER=n8n_prod
# Versão do client (pg_dump/psql) usado por backup/restore/psql na VM.
# Acompanhe a major da instância.
POSTGRES_VERSION=18

# Queue mode: main + redis + workers. e2-standard-4 = 4 vCPU / 16 GB.
COMPOSE_PROFILES=
EXECUTIONS_MODE=
N8N_WORKER_REPLICAS=2
N8N_WORKER_CONCURRENCY=10
OFFLOAD_MANUAL_EXECUTIONS_TO_WORKERS=true

# Retenção de execuções: 14 dias ou 50k registros, o que vier primeiro.
EXECUTIONS_DATA_MAX_AGE=336
EXECUTIONS_DATA_PRUNE_MAX_COUNT=50000
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all

TZ=America/Sao_Paulo
N8N_LOG_LEVEL=info
N8N_VERSION_NOTIFICATIONS_ENABLED=false
N8N_METRICS=false

# Backups locais (pg_dump do Cloud SQL + export de workflows) em /opt/n8n/backups.
BACKUP_RETENTION_DAYS=14
# Opcional: bucket GCS para copiar os backups. Exige que a SA da VM tenha o
# scope de escrita no Storage (ver README › Backups).
BACKUP_BUCKET=
