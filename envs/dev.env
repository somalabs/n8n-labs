# Configuração NÃO sensível de desenvolvimento (n8n-dev, us-central1-f, e2-medium).
# Secrets vêm do Secret Manager na hora do deploy — não coloque aqui.

# Dev pode andar na frente de prod para validar a versão antes de promover.
N8N_VERSION=2.38.7
POSTGRES_VERSION=16

N8N_HOST=n8n-prod.somalabs.com.br
ACME_EMAIL=daniel.takemura@somagrupo.com.br

# Regular mode: um único processo n8n (e2-medium = 2 vCPU / 4 GB).
COMPOSE_PROFILES=
EXECUTIONS_MODE=regular

# Retenção curta: dev acumula lixo de teste.
EXECUTIONS_DATA_MAX_AGE=72
EXECUTIONS_DATA_PRUNE_MAX_COUNT=10000
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all

TZ=America/Sao_Paulo
N8N_LOG_LEVEL=debug
N8N_VERSION_NOTIFICATIONS_ENABLED=true
N8N_METRICS=false

BACKUP_RETENTION_DAYS=7
BACKUP_BUCKET=
